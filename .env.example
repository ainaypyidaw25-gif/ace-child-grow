# ACE Child Grow — environment variables (EXAMPLE ONLY, no real secrets here)
# Copy to .env.local and fill with real values. Never commit .env files.

# --- App config ---
VITE_APP_ENV=development
VITE_DEFAULT_LOCALE=mm

# --- Convex (the backend: database, auth, functions and file storage) ---
VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud

# --- Myan Myan Pay (SERVER-SIDE CONVEX ENV ONLY) ---
# Never put these values in VITE_* variables. Set them on the selected Convex
# deployment with `npx convex env set NAME VALUE`.
MMPAY_ENV=sandbox
MMPAY_WEBHOOK_URL=https://YOUR-DEPLOYMENT.convex.site/mmpay/webhook

MMPAY_SANDBOX_APP_ID=MMxxxxxxx
MMPAY_SANDBOX_PUBLISHABLE_KEY=pk_test_xxxxx
MMPAY_SANDBOX_SECRET_KEY=sk_test_xxxxx
MMPAY_SANDBOX_API_BASE_URL=https://MERCHANT-API-BASE-URL-FROM-MYANMYANPAY

MMPAY_PRODUCTION_APP_ID=MMxxxxxxx
MMPAY_PRODUCTION_PUBLISHABLE_KEY=pk_live_xxxxx
MMPAY_PRODUCTION_SECRET_KEY=sk_live_xxxxx
MMPAY_PRODUCTION_API_BASE_URL=https://MERCHANT-API-BASE-URL-FROM-MYANMYANPAY
# Convex server access mode. Use `testing` to unlock all parent features
# without showing payment prompts during closed testing. Remove or set to
# `production` before enabling paid subscriptions.
APP_ACCESS_MODE=testing

# Convex Auth password/PIN recovery email (Resend). Verify the sender domain
# before production and set these on the Convex deployment, never in the app.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=ACE Child Grow <no-reply@acegroup.com.mm>

# Google OAuth credentials (SERVER-SIDE CONVEX ENV ONLY)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
