# ACE Child Grow — environment variables (EXAMPLE ONLY, no real secrets here)
# Copy to .env.local and fill with real values. Never commit .env files.

# --- Supabase (primary backend: Postgres + Auth + Storage + RLS) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (used by Edge Functions / admin tasks). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- App config ---
VITE_APP_ENV=development
VITE_DEFAULT_LOCALE=mm

# --- Error monitoring (optional; leave blank to disable) ---
VITE_SENTRY_DSN=

# --- Convex (chosen backend) ---
VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
